# ==========================================================================
#  Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- Application ---
APP_NAME="Credit Yetu"
ENV=development                       # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Postgres connection string ---
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://credit:credit@localhost:5432/credit_scoring
#
# Using a managed/shared Postgres instance (e.g. Aiven) where this app's
# tables must live in their own schema rather than `public`? Add sslmode and
# a search_path via the `options` param — no code changes needed, table
# names in migrations/*.sql and the ORM stay unqualified either way:
#   postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require&options=-c%20search_path%3D<your_schema>,public
#
# On a connection-constrained managed tier, also lower these so this app alone
# can't exhaust the instance's max_connections (check `SHOW max_connections;`
# and leave headroom for other apps/tools sharing it):
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Security ---
# Secret used to sign/verify internal tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
# Pepper mixed into API-key hashing (rotate carefully — invalidates existing keys)
API_KEY_PEPPER=CHANGE_ME_another_long_random_value
# Comma-separated allowed CORS origins (use explicit origins in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- File storage ---
# Where uploaded statements and generated PDFs/Excels are written.
# In production point this at an object store (S3/GCS) via a storage adapter.
STORAGE_DIR=./_storage

# --- Statement extraction ---
OCR_ENABLED=true                      # set false if tesseract/poppler not installed
OCR_DPI=300                           # rasterization DPI for scanned docs
MAX_UPLOAD_MB=25

# --- KYC / CRB provider ---
# `mock` uses the built-in sandbox provider (no real data, safe for dev).
# Swap to `spinmobile` (or your own) once you hold the integration contracts.
KYC_PROVIDER=mock
KYC_BASE_URL=
KYC_API_KEY=

# --- Async processing ---
# `background` uses FastAPI BackgroundTasks (no extra infra).
# Swap to `celery` for a real queue in production.
TASK_BACKEND=background

# --- ML shadow-scoring ---
# The rule engine (app/services/scoring) stays authoritative for credit_score
# and the loan limit. This trains a secondary model purely for monitoring
# and calibration once real loan outcomes exist — see README > "ML
# shadow-scoring". It is refused activation below ML_MIN_SAMPLES labeled,
# final outcomes; there is no synthetic/proxy labelling anywhere.
ML_ARTIFACTS_DIR=./app/ml/artifacts
ML_MIN_SAMPLES=40
ML_TEST_SIZE=0.25
